# Site E-Ciné (Next.js) — variables serveur uniquement : aucune n'est exposée au navigateur sauf NEXT_PUBLIC_*.
# Ne JAMAIS mettre un secret dans une variable NEXT_PUBLIC_.

# URL de l'API vue par le serveur Next.js (réseau privé si possible)
API_INTERNAL_URL=http://localhost:4000
# Origines publiques (CSP, liens absolus, métadonnées)
SITE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
MEDIA_PUBLIC_URL=http://localhost:4000/media
# Hôte canonique en production (redirection 301 des autres hôtes), vide en local
CANONICAL_HOST=

# Secrets partagés avec l'API (mêmes valeurs que apps/api/.env)
SERVICE_API_KEY=
REVALIDATE_SECRET=

# Cookies Secure (__Host-) : true en production
COOKIE_SECURE=false

# Cloudflare Turnstile : clé de site publique (test « toujours valide » en local)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Page /design (catalogue de composants) : désactivée en production
DESIGN_PAGE_ENABLED=true
