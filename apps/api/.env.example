# API E-Ciné — variables d'environnement (copier en .env, ne JAMAIS committer .env).
# Générer chaque secret : openssl rand -base64 48   (MEDIA_KEY_SECRET : openssl rand -base64 32)

NODE_ENV=development
PORT=4000
# Nombre de proxys de confiance devant l'API (Caddy = 1).
TRUST_PROXY=1
LOG_LEVEL=info

# Services locaux : pnpm infra:up (ports 55432 / 56379 pour éviter un PostgreSQL déjà installé)
DATABASE_URL=postgresql://ecine:ecine_dev_local@localhost:55432/ecine
REDIS_URL=redis://:ecine_dev_local@localhost:56379

# Origines publiques (HTTPS obligatoire en production, y compris REVALIDATE_URL)
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
MEDIA_PUBLIC_URL=http://localhost:4000/media
# Origines supplémentaires autorisées (CORS), séparées par des virgules (ex. https://admin.e-cine.example)
CORS_ORIGINS=

# Secrets (32+ caractères)
JWT_ACCESS_SECRET=
PLAYBACK_TOKEN_SECRET=
# Clé maîtresse AES-256 (32 octets en base64) : chiffre les clés vidéo et les secrets 2FA. Rotation = procédure documentée.
MEDIA_KEY_SECRET=
IP_HASH_SALT=
# Partagée avec Next.js (variables serveur uniquement, jamais NEXT_PUBLIC_)
SERVICE_API_KEY=
REVALIDATE_SECRET=
REVALIDATE_URL=http://localhost:3000/api/revalidate

# Cookies Secure : true en production (HTTPS). En local HTTP : false.
COOKIE_SECURE=false

# Stockage local des médias (sources privées, HLS, images compressées)
STORAGE_DIR=../../storage

# Worker de transcodage : binaires FFmpeg (dans le PATH par défaut ; installés dans l'image Docker « worker »)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Seed de démonstration (pnpm --filter @ecine/api db:seed, jamais en production) : compte SUPER_ADMIN initial.
# Mot de passe de 12 caractères minimum, propre à cet environnement ; activer la 2FA à la première connexion.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# E-mails : log (développement uniquement : écrit les e-mails, donc les liens, dans les journaux) | resend (obligatoire en production)
# MAIL_FROM : adresse du domaine vérifié chez Resend (la valeur e-cine.example est refusée en production)
MAIL_DRIVER=log
MAIL_FROM=E-Ciné <no-reply@e-cine.example>
RESEND_API_KEY=

# Notifications Web Push des rappels (ADR-0014). Générer : npx web-push generate-vapid-keys
# Laisser vide pour n'envoyer les rappels que par e-mail. La clé privée ne quitte jamais l'API.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@e-cine.example

# Cloudflare Turnstile (obligatoire en production)
TURNSTILE_SECRET=

# 2FA obligatoire pour ADMIN/SUPER_ADMIN (ne peut être désactivée qu'en local)
ADMIN_MFA_REQUIRED=false
# Documentation OpenAPI sur /docs (désactivée par défaut en production)
SWAGGER_ENABLED=true
