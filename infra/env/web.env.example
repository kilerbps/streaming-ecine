# /etc/ecine/web.env : site Next.js (variables serveur, lues à l'exécution). Créé par
# `sudo infra/secrets.sh init`.
# Rendu serveur → API par Caddy (réseau Docker interne), réparti entre les instances.
API_INTERNAL_URL=http://caddy:8080
SITE_URL=https://ecine.art
API_PUBLIC_URL=https://api.ecine.art
MEDIA_PUBLIC_URL=https://media.ecine.art
CANONICAL_HOST=ecine.art

# Mêmes valeurs que api.env (recopiées par secrets.sh).
SERVICE_API_KEY=__API__
REVALIDATE_SECRET=__API__
DEVICE_COOKIE_SECRET=__GENERE__

# Phase de test : non indexée (robots.txt et X-Robots-Tag), ADR-0016.
SITE_INDEXABLE=false
DESIGN_PAGE_ENABLED=false
