# /etc/ecine/api.env : API, worker et migrations (apps/api/src/config/env.ts). Créé par
# `sudo infra/secrets.sh init` : les « __GENERE__ » sont remplacés par des secrets tirés sur le
# serveur ; les valeurs vides se règlent avec `sudo infra/secrets.sh set api CLÉ` (saisie masquée).
NODE_ENV=production
PORT=4000
# Un proxy de confiance devant l'API : Caddy (qui transmet l'IP établie depuis Cloudflare).
TRUST_PROXY=1
LOG_LEVEL=info

DATABASE_URL=postgresql://ecine:__POSTGRES_PASSWORD__@postgres:5432/ecine
REDIS_URL=redis://:__REDIS_PASSWORD__@redis:6379

APP_URL=https://ecine.art
API_PUBLIC_URL=https://api.ecine.art
MEDIA_PUBLIC_URL=https://media.ecine.art
CORS_ORIGINS=

JWT_ACCESS_SECRET=__GENERE__
PLAYBACK_TOKEN_SECRET=__GENERE__
MEDIA_KEY_SECRET=__GENERE32__
IP_HASH_SALT=__GENERE__
# Partagées avec le site (web.env) : mêmes valeurs, recopiées par secrets.sh.
SERVICE_API_KEY=__GENERE__
REVALIDATE_SECRET=__GENERE__
# Webhook vers le site sur le réseau Docker interne (ADR-0016).
REVALIDATE_URL=http://web:3000/api/revalidate

COOKIE_SECURE=true

# Resend : domaine ecine.art vérifié, puis clé API (secrets.sh set api RESEND_API_KEY).
MAIL_DRIVER=resend
MAIL_FROM=E-Ciné <no-reply@ecine.art>
RESEND_API_KEY=

# Web Push (ADR-0014) : paire générée par `secrets.sh vapid` après la première construction.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Cloudflare Turnstile : clé secrète du widget ecine.art.
TURNSTILE_SECRET=

# Deux semaines d'observation au lancement (ADR-0015), puis « enforce ».
RATE_LIMIT_MODE=observe
ADMIN_MFA_REQUIRED=true
SWAGGER_ENABLED=false
