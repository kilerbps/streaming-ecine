# /etc/ecine/compose.env : réglages de docker-compose.prod.yml (aucun secret). Créé par
# `sudo infra/secrets.sh init` ; les valeurs vides se règlent avec `sudo infra/secrets.sh set compose CLÉ`.
SITE_DOMAIN=ecine.art
API_DOMAIN=api.ecine.art
MEDIA_DOMAIN=media.ecine.art
# Adresse du compte Let's Encrypt (avis d'expiration des certificats).
ACME_EMAIL=
# « ouverte » avant le proxy Cloudflare, « cloudflare » ensuite (accès direct au VPS refusé).
CADDY_ORIGIN=ouverte
# Clé de site Turnstile (publique, figée dans l'image du site à la construction).
TURNSTILE_SITE_KEY=
# Transitions de page : « 1 » après essai sur appareils réels (docs/AGENTS-REFONTE.md).
VIEW_TRANSITIONS=0
# Révision déployée (écrite par deploy.sh).
TAG=latest
