# /etc/ecine/backup.env : sauvegardes chiffrées vers Cloudflare R2 (infra/backup/backup.sh).
# Rempli par `sudo infra/secrets.sh age` (clé publique) et `sudo infra/secrets.sh r2` (accès R2).
AGE_RECIPIENT=
RCLONE_REMOTE=r2:ecine-sauvegardes
# Remote rclone « r2 » décrit par l'environnement (aucun fichier rclone.conf).
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_REGION=auto
RCLONE_CONFIG_R2_ACL=private
# Jeton limité au seul compartiment : rclone ne doit ni lister ni créer de compartiments.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
RCLONE_CONFIG_R2_ENDPOINT=
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
