# Caddy : HTTPS automatique (Let's Encrypt), HSTS, redirection HTTP → HTTPS (par défaut).
# Le site public (Next.js) est servi par Vercel ; ce VPS sert l'API et les médias.
{
	email {$ACME_EMAIL}
	servers {
		# Limite la taille des en-têtes et les délais pour résister aux connexions lentes.
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

(securite) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# API (NestJS) : tout passe par le proxy ; corps limités côté API (100 Ko, 4 Mio pour les morceaux d'envoi).
{$API_DOMAIN} {
	import securite
	encode zstd gzip
	request_body {
		max_size 5MB
	}
	reverse_proxy api:4000 {
		header_up X-Real-IP {remote_host}
	}
}

# Médias : images compressées servies directement (publiques, immuables) ;
# segments HLS chiffrés uniquement via l'API (jeton vérifié). Jamais de listage de répertoire.
{$MEDIA_DOMAIN} {
	import securite

	handle_path /images/* {
		root * /data/storage/images
		header Cache-Control "public, max-age=31536000, immutable"
		header Cross-Origin-Resource-Policy "cross-origin"
		file_server
	}

	handle /hls/* {
		rewrite * /media{uri}
		reverse_proxy api:4000
	}

	handle {
		respond "Introuvable" 404
	}
}
